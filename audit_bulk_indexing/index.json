{
  "settings": {
    "index.refresh_interval": "{{ refresh_interval | default('-1') }}",
    "index.requests.cache.enable": false
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "message": {
        "type": "keyword"
      },
      "counter": {
        "type": "long"
      }
    }
  }
}
